<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:team="clr-namespace:LabShared"
             x:Class="Lab1_1_MAUI_XAML.MainPage"
             Title="Popov Absolute Page"
             BackgroundColor="Orange"
             >
    <Grid RowDefinitions="Auto,*">
        <!-- Сведения о команде: данные берутся из TeamInfo через расширение разметки x:Static -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource TeamBannerColor}"
                StrokeThickness="0"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Лабораторная работа 1. Задача 1"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="Присоединённые свойства AbsoluteLayout.LayoutBounds / LayoutFlags"
                           TextColor="#FDE68A"
                           FontSize="14" />
                    <Label Text="{x:Static team:TeamInfo.Group}"
                           TextColor="White"
                           FontSize="15"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="{x:Static team:TeamInfo.Members}"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <AbsoluteLayout Grid.Row="1" BackgroundColor="Yellow">
            <BoxView Color="Lavender"
                     AbsoluteLayout.LayoutBounds="0.33, 0, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Red"
                     AbsoluteLayout.LayoutBounds="1, 0, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Green"
                     AbsoluteLayout.LayoutBounds="0, 0.33, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Blue"
                     AbsoluteLayout.LayoutBounds="0.67, 0.33, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Magenta"
                     AbsoluteLayout.LayoutBounds="0.33, 0.67, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Gray"
                     AbsoluteLayout.LayoutBounds="1, 0.67, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Black"
                     AbsoluteLayout.LayoutBounds="0, 1, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="Olive"
                     AbsoluteLayout.LayoutBounds="0.67, 1, 0.25, 0.25"
                     AbsoluteLayout.LayoutFlags="All" />
        </AbsoluteLayout>
    </Grid>
</ContentPage>
