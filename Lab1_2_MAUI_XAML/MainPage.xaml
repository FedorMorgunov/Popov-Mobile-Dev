<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Lab1_2_MAUI_XAML;assembly=Lab1_2_MAUI_XAML"
             xmlns:team="clr-namespace:LabShared"
             x:Class="Lab1_2_MAUI_XAML.MainPage"
             Title="Clock Page"
             x:DataType="local:ClockViewModel"
             BackgroundColor="Aqua">
    <ContentPage.BindingContext>
        <local:ClockViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Сведения о команде: данные берутся из TeamInfo через расширение разметки x:Static -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource TeamBannerColor}"
                StrokeThickness="0"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Лабораторная работа 1. Задача 2"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="Привязка Label к ClockViewModel (INotifyPropertyChanged)"
                           TextColor="#FDE68A"
                           FontSize="14" />
                    <Label Text="{x:Static team:TeamInfo.Group}"
                           TextColor="White"
                           FontSize="15"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="{x:Static team:TeamInfo.Members}"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Grid.Row="1"
               Text="{Binding DateTime, StringFormat='{0:T}'}"
               FontSize="60"
               TextColor="Black"
               BackgroundColor="Orange"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Grid>
</ContentPage>
